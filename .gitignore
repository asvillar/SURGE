# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be added to the global gitignore or merged into this project gitignore.  For a PyCharm
#  project, it is recommended to exclude the whole .idea/ directory.
.idea/

# VS Code
.vscode/
*.code-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Project specific
# NOTE: originally a blanket `models/` rule; narrowed 2026-04-21 to only
# ignore runtime artifact trees (runs/<tag>/models/, data/**/models/), not
# the tracked `surge/model*` source packages. A bare `models/` here caused
# CI on a fresh clone to pick up `surge/models.py` while local checkouts
# loaded an untracked `surge/models/` package — see commit 6f33d89.
runs/**/models/
data/**/models/
*.joblib
results.json

# Benchmark / experiment result trees (timestamped subdirs; Windows-unsafe if ':')
results/*/
!results/.gitkeep

# Local-only subtrees (not distributed).
docs/internal/
scripts/**/internal/
configs/internal/
examples/internal/
notebooks/**/internal/
templates/internal/

# DataGenerator batch outputs (generated data, not tracked)
examples/datagen/batch*/
examples/data/*
!examples/data/.gitkeep

# Large datasets and workflow outputs
runs/
runs

# Benchmark run outputs are generated artifacts: never tracked.
# Curated result snapshots belong in release assets or docs, not the tree.
benchmark_reports/
catboost_info/

# MLflow tracking state (local experiment database + run store)
mlflow.db
mlruns/

# Editor configuration (local)

# Backup and scratch files
*.backup
*.nohup.out
nohup.out

# Benchmark runtime data cache (downloaded or generated on first run).
# Directory skeleton (subdirs + .gitkeep files) IS tracked; data files are not.
data/datasets/benchmarks/**
!data/datasets/benchmarks/**/
!data/datasets/benchmarks/**/.gitkeep

# Local run archives
data/runs/

# Local sandbox folder (not distributed).
internal/
# Local launch logs
logs/

# Exclude all PNGs (research plots, run figures, etc.) except the
# design-system logos we ship in data/logos/ and the curated README
# figures under docs/assets/readme/ (regenerated by
# examples/viz_theme_gallery.py, updated deliberately).
*.png
!data/logos/*.png
!docs/assets/readme/*.png
!docs/assets/readme/dark/*.png
!docs/assets/gallery/*.png

comprehensive_eigenmode*.png
test_*.png
eigenmode_*.png
field_reconstruction*.png
2d_field_*.png

# Notebook outputs and checkpoints
.ipynb_checkpoints/
notebooks/*.ipynb
notebooks/*.csv

# Developer diagnostics artifacts
surge_dev_artifacts/

# Documentation files explaining changes/refactoring (keep local only)
REFACTORING_SUMMARY.md
*_REFACTORING*.md
*_CHANGES*.md

# OS files
.DS_Store

# Test artifacts and outputs
test_outputs/

slurm_logs/

slurm_logs/

# Batch logs
logs/

# Sphinx autosummary regenerates these on every build.
docs/_build/
docs/api_reference/generated/

examples/viz_gallery_output/
dist_test/

# Local datasets are never tracked; benchmark caches are handled by the rules above
/data/datasets/*/
!/data/datasets/benchmarks/
